# ================================================================
# DRISHTI-X — Environment Configuration Example (.env.example)
# Copy this file to .env and adjust variables for your local setup.
# DO NOT commit real secrets or credentials to version control.
# ================================================================

# Application Environment
APP_ENV=development                   # development | production | demo
DEBUG=True
APP_NAME=DRISHTI-X
APP_VERSION=2.0.0

# Security (Generate a secure key with: openssl rand -hex 32)
SECRET_KEY=CHANGE_ME_IN_PRODUCTION_openssl_rand_hex_32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480       # 8 hours

# Database Configuration
# PostgreSQL is the primary database. If unreachable, the system automatically
# falls back to zero-configuration local SQLite at retinatrust.db.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/drishti_x

# Google OAuth 2.0 Client ID (from Google Cloud Console)
GOOGLE_CLIENT_ID=YOUR_GOOGLE_OAUTH_CLIENT_ID.apps.googleusercontent.com

# Service URLs & CORS
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# File Storage
UPLOAD_DIR=uploads
REPORTS_DIR=reports
MAX_IMAGE_SIZE_MB=20

# AI Model Checkpoint Paths
MODEL_DIR=models/weights
MODEL_STATUS=TRAINED                  # NOT_TRAINED | TRAINED | VALIDATED | DEMO
DEMO_MODE=False

# External Diagnostic Integrations
MATLAB_AVAILABLE=False

